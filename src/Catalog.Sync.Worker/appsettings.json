{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Sync": {
    "IntervalMinutes": 15,
    "RunOnStartup": true,
    "BatchSize": 200
  },
  "FileLogging": {
    "Enabled": true,
    "DirectoryPath": "logs",
    "RetentionDays": 30
  },
  "ProductSource": {
    "JsonFilePath": "fixtures/products.json"
  },
  "WordPress": {
    "BaseUrl": "http://localhost:8080",
    "RunsEndpoint": "/wp-json/catalog-sync/v1/runs",
    "Username": "",
    "ApplicationPassword": "",
    "RequestTimeoutSeconds": 60,
    "MaxRetryAttempts": 3,
    "RetryBaseDelayMilliseconds": 200,
    "AllowInsecureHttpForLocalDevelopment": true
  }
}
