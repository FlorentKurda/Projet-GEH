# Copiez ce fichier vers .env. Ces valeurs sont réservées au développement local.
WORDPRESS_PORT=8080
WORDPRESS_SITE_URL=http://localhost:8080
WORDPRESS_SITE_TITLE=Catalogue produits local

WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress-local-change-me
MARIADB_ROOT_PASSWORD=mariadb-root-local-change-me

WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=wordpress-admin-local-change-me
WORDPRESS_ADMIN_EMAIL=admin@example.test

CATALOG_SYNC_USER=catalog_sync
CATALOG_SYNC_EMAIL=catalog-sync@example.test
CATALOG_SYNC_DISPLAY_NAME=Synchronisation catalogue
CATALOG_SYNC_APPLICATION_NAME=Catalog Sync Worker
